# Horizon Dark, ported 1:1 from the old ~/.config/i3/i3lock-blur.sh
# color values (i3lock and swaylock take the same rrggbb[aa] hex format).
# No native blur support in swaylock -- using the pre-blurred
# ~/.config/gtklock/lockbg.jpg (generated via ImageMagick) as a static
# background image instead. No clock support either (vanilla swaylock has
# no --clock flag; that was swaylock-effects-only, and its COPR builds are
# dead -- see ~/.claude/plans/zany-finding-newt.md).

image=/home/eli/.config/gtklock/lockbg.jpg
scaling=fill
color=1e181aff

font=Hack Nerd Font Mono
indicator-radius=90
indicator-thickness=7

ring-color=5b5858bb
inside-color=1e181abb
ring-ver-color=26bbd9ff
inside-ver-color=1e181abb
ring-wrong-color=e95678ff
inside-wrong-color=1e181abb

line-color=00000000
separator-color=00000000

key-hl-color=29d398ff
bs-hl-color=e95678ff

text-color=e0e0e0ff
text-ver-color=e0e0e0ff
text-wrong-color=e95678ff
text-caps-lock-color=fab795ff

layout-text-color=e0e0e0ff
