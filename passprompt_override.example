# Enables claude-sudo's descriptive password prompt.
#
# claude-sudo works without this drop-in; the effect is purely cosmetic. By
# default PAM supplies its own bare "Password:" prompt and sudo's -p text (the
# command + justification that claude-sudo builds) is never shown. With
# passprompt_override set, sudo's -p prompt wins and the askpass dialog shows
# what is being run and why.
#
# Install once per machine, from the chezmoi source dir
# (`chezmoi source-path`, where this file lives):
#   sudo cp passprompt_override.example /etc/sudoers.d/passprompt_override
#   sudo chmod 440 /etc/sudoers.d/passprompt_override
#   sudo visudo -cf /etc/sudoers.d/passprompt_override   # verify syntax
#
# The installed name must have no dot in it - sudo ignores files in
# /etc/sudoers.d/ whose names contain "." - so it is NOT named *.example there.
#
# The askpass GUI itself is a fork of lxqt-openssh-askpass with the SSH-only
# wording stripped, so the claude-sudo prompt doesn't read as an SSH passphrase
# request. Clone and build it once per machine:
#   git clone git@github.com:elzimm-software/lxqt-nonssh-askpass.git ~/Projects/lxqt-nonssh-askpass
#   cd ~/Projects/lxqt-nonssh-askpass
#   cmake -B build -S . -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_BUILD_TYPE=Release
#   cmake --build build -j"$(nproc)"
#   sudo cmake --install build          # -> /usr/local/bin/lxqt-openssh-askpass
# Build deps (Fedora): cmake gcc-c++ liblxqt-devel libqtxdg-devel
#   qt6-qtbase-devel qt6-linguist qt6-qttools-devel kf6-kwindowsystem-devel
#   lxqt-build-tools
# .zshenv points SUDO_ASKPASS (and SSH_ASKPASS) at that /usr/local binary; the
# rpm-owned /usr/libexec/openssh/lxqt-openssh-askpass is left untouched.

Defaults passprompt_override
