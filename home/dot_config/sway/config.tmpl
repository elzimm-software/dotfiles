# (163/96 ~= 1.7). Adjust live with `swaymsg output eDP-1 scale <value>` to
# taste.
output eDP-1 scale 1.7
output eDP-1 bg ~/.config/backgrounds/st-celestine-fit.jpg fill

# /etc/X11/xorg.conf.d/30-touchpad.conf (Tapping + NaturalScrolling) is an
# Xorg InputClass config -- sway doesn't read it at all, it has its own
# libinput config below. Without this, tap-to-click reverts to libinput's
# default (off).
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

