{{ if eq .machine "desktop" -}}
# Desktop sway config. Mirrored (with layout/navigation reinterpreted for
# scroll's model) in ~/.config/scroll/config.tmpl -- keep exec lines,
# keybindings, and output layout in sync by hand between the two when
# changing either.

set $mod Mod4

font pango:Hack Nerd Font Mono 11

default_border pixel 1
default_floating_border pixel 1

# Monitor layout: HDMI-A-2 (Acer KA272, vertical, left) - DP-2 (primary,
# center) - HDMI-A-1 (Vizio TV, right). Mirrors the xrandr layout the
# LightDM greeter uses (system/usr/local/bin/desktop-monitors.sh) so sway's
# own layout matches what's on screen before login -- note wlroots names
# HDMI outputs differently than xrandr did (HDMI-A-1/HDMI-A-2 here vs
# HDMI-0/HDMI-1 there); confirmed by EDID (make/model), not by name.
output DP-2 mode 1920x1080@240Hz position 1080,0
output HDMI-A-2 mode 1920x1080@75Hz position 0,-840 transform 270
output HDMI-A-1 mode 1920x1080@59.94Hz position 3000,0

# LightDM doesn't register this session with systemd the way GNOME/KDE do,
# so graphical-session.target (and anything gated on it, e.g. xdg-desktop-portal)
# never starts on its own. sway-session.target (~/.config/systemd/user/sway-session.target)
# pulls it in via BindsTo=.
exec systemctl --user start sway-session.target

# Force system dark mode preference (GTK/Firefox/portal-aware apps read this)
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita'

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec dex-autostart --autostart --environment sway

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
# sway's bar has a built-in StatusNotifierItem tray, so this just shows up.
exec nm-applet

# swayidle listens for the logind Lock/PrepareForSleep signals -- the power
# button (see logind.conf.d/10-power-button-suspend.conf) and
# `loginctl lock-session` ($mod+slash below) funnel through here. -w holds
# the sleep lock until the lock command returns. The 180s timeout only dims
# (does not lock) -- fullscreen suppression is handled natively by the
# inhibit_idle rule below, audio suppression by idle-dim.sh itself. swaylock
# is the mvforell fork (ext-session-lock-v1 + clock); it reads
# ~/.config/swaylock/config (pre-blurred lockbg.jpg as the background). The
# `pgrep ||` guard stops lock + before-sleep both firing on suspend from
# stacking two lockers.
exec swayidle -w \
    lock 'pgrep -x swaylock || swaylock --daemonize' \
    before-sleep 'pgrep -x swaylock || swaylock --daemonize' \
    timeout 180 '~/.config/sway/idle-dim.sh' \
    resume 'brightnessctl -r'

# Volume control (voicemeeter-style buses)
# plain = Music/Media, Ctrl = Games/Apps, Shift = Voice (Discord)
bindsym XF86AudioRaiseVolume exec ~/.config/sway/volume-osd.sh up Bus-Music Music
bindsym XF86AudioLowerVolume exec ~/.config/sway/volume-osd.sh down Bus-Music Music
bindsym XF86AudioMute exec ~/.config/sway/volume-osd.sh mute Bus-Music Music

bindsym Control+XF86AudioRaiseVolume exec ~/.config/sway/volume-osd.sh up Bus-Games Games
bindsym Control+XF86AudioLowerVolume exec ~/.config/sway/volume-osd.sh down Bus-Games Games
bindsym Control+XF86AudioMute exec ~/.config/sway/volume-osd.sh mute Bus-Games Games

bindsym Shift+XF86AudioRaiseVolume exec ~/.config/sway/volume-osd.sh up Bus-Voice Voice
bindsym Shift+XF86AudioLowerVolume exec ~/.config/sway/volume-osd.sh down Bus-Voice Voice
bindsym Shift+XF86AudioMute exec ~/.config/sway/volume-osd.sh mute Bus-Voice Voice

# Media control
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Launch Flameshot GUI for click-and-drag capture
bindsym Print exec flameshot gui

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
# (sway doesn't have i3's "modifier titlebar" mode -- titlebar dragging is
# already on by default whenever tiling_drag is enabled.)
tiling_drag enable

# nm-applet briefly loses its systray to embed into when the bar restarts,
# so it falls back to a normal top-level window that sway would otherwise
# tile -- keep it off to the side instead.
for_window [class="Nm-applet"] floating enable, move scratchpad
for_window [app_id="Nm-applet"] floating enable, move scratchpad

# GPG pinentry dialogs -- relying on sway's floating heuristics for these
# was flaky (floated inconsistently); force it explicitly. Native Wayland
# reports app_id=org.gnupg.pinentry-qt; class= covers an XWayland fallback.
for_window [app_id="org.gnupg.pinentry-qt"] floating enable, move position center
for_window [class="pinentry-qt"] floating enable, move position center

# SSH_ASKPASS's GUI passphrase prompt (system-wide default set by the
# lxqt-openssh-askpass package's own /etc/profile.d script, independent of
# anything in this repo) -- same deal, force it to float.
for_window [app_id="lxqt-openssh-askpass"] floating enable, move position center
for_window [class="lxqt-openssh-askpass"] floating enable, move position center

# Don't dim/lock the screen while any window is fullscreen (video,
# presentations, etc). Native sway replacement for xidlehook's
# --not-when-fullscreen.
for_window [app_id=".*"] inhibit_idle fullscreen

# start a terminal
bindsym $mod+Return exec alacritty
# start a browser
bindsym $mod+b exec firefox
# start emacs
bindsym $mod+c exec emacs

# kill focused window
bindsym $mod+q kill

bindsym $mod+space exec rofi -show drun -show-icons

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# scratchpad
bindsym $mod+Shift+grave move scratchpad
bindsym $mod+grave scratchpad show

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+d floating toggle

# change focus between tiling / floating windows
bindsym $mod+d focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# sway has no i3-style "restart in place" -- a Wayland compositor can't
# restart without killing every client's connection (unlike i3, where X11
# is a separate server that survives a WM restart). reload is the closest
# equivalent: it re-reads this config and applies keybinding/appearance/bar
# changes live, but won't respawn already-running exec'd daemons (swayidle,
# dunst, etc.) -- that needs a full logout/login.
bindsym $mod+Shift+r reload
# Force refresh the bar (sway has no restart -- killing i3blocks and
# re-issuing status_command over IPC respawns it in place)
bindsym $mod+Shift+b exec killall i3blocks; swaymsg bar bar-0 status_command i3blocks
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
# lock the screen (asks logind to lock, which swayidle picks up)
bindsym $mod+slash exec loginctl lock-session

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym j resize shrink width 1 px or 1 ppt
        bindsym k resize grow height 1 px or 1 ppt
        bindsym l resize shrink height 1 px or 1 ppt
        bindsym semicolon resize grow width 1 px or 1 ppt

        bindsym Left resize shrink width 1 px or 1 ppt
        bindsym Down resize grow height 1 px or 1 ppt
        bindsym Up resize shrink height 1 px or 1 ppt
        bindsym Right resize grow width 1 px or 1 ppt

        bindsym Shift+j resize shrink width 10 px or 10 ppt
        bindsym Shift+k resize grow height 10 px or 10 ppt
        bindsym Shift+l resize shrink height 10 px or 10 ppt
        bindsym Shift+semicolon resize grow width 10 px or 10 ppt

        bindsym Shift+Left resize shrink width 10 px or 10 ppt
        bindsym Shift+Down resize grow height 10 px or 10 ppt
        bindsym Shift+Up resize shrink height 10 px or 10 ppt
        bindsym Shift+Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Start a bar to display a workspace bar (plus the system information
# i3blocks finds out). sway's bar has a built-in StatusNotifierItem tray,
# so nm-applet's icon just shows up -- no tray_output override needed.
bar {
        status_command i3blocks
        position top
        font pango:Hack, Symbols Nerd Font Mono 11

        colors {
                background #1e181a
                statusline #e0e0e0
                separator  #5b5858

                focused_workspace  #26bbd9 #26bbd9 #1e181a
                active_workspace   #16161c #16161c #e0e0e0
                inactive_workspace #1e181a #1e181a #5b5858
                urgent_workspace   #e95678 #e95678 #1e181a
                binding_mode       #ee64ac #ee64ac #1e181a
        }
}

# Per-output wallpaper: DP-2 (primary, mirrored to the greeter) center,
# HDMI-A-1 (TV) right, HDMI-A-2 (Acer KA272) left. Unlike the old i3/feh
# setup, sway places these natively per output -- no compositing hack needed.
exec_always ~/.config/sway/set-wallpaper.sh DP-2=$HOME/.config/backgrounds/st-gerstahl.jpg HDMI-A-1=$HOME/.config/backgrounds/st-ephrael.jpg HDMI-A-2=$HOME/.config/backgrounds/st-celestine.jpg

exec /usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh
exec dunst
exec flameshot
